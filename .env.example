# Copy this file to .env and replace every placeholder.
# Never commit .env or put real credentials in source control.

# Required: use a long, unique random value for production/local use.
SECRET_KEY=replace-with-a-long-random-secret

# MySQL example (database must exist first):
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@localhost/AssetVerifyApp?charset=utf8mb4

# Password for the initial admin account created by `flask --app app init-db`.
# Choose a strong password; do not use a sample/default password.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional: set a Fernet key if enabling encrypted MFA secrets.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
